<Project>
  <!--
    Shared settings for the .NET examples.

    By default each example references the released DesktopAccountingAPI.QuickBooksDesktop package
    from NuGet, version 0.5.0 (another version: -p:DaapiPackageVersion=<version>).

    For SDK development, build against the SDK source checked out next to this repository with
    -p:UseNuGetPackage=false:
      $(SDK_REPOS_DIR)/quickbooks-desktop-dotnet   (environment variable), else
      <examples repo root>/sdk/quickbooks-desktop-dotnet
    Override the location with -p:SdkReposDir=/path/to/sdk-repos.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>Examples</RootNamespace>

    <SdkReposDir Condition="'$(SdkReposDir)' == '' and '$(SDK_REPOS_DIR)' != ''">$(SDK_REPOS_DIR)</SdkReposDir>
    <SdkReposDir Condition="'$(SdkReposDir)' == ''">$(MSBuildThisFileDirectory)../sdk</SdkReposDir>
    <DaapiSdkProject>$([MSBuild]::NormalizePath('$(SdkReposDir)', 'quickbooks-desktop-dotnet', 'src', 'DesktopAccountingApi.QuickBooksDesktop', 'DesktopAccountingApi.QuickBooksDesktop.csproj'))</DaapiSdkProject>
    <UseNuGetPackage Condition="'$(UseNuGetPackage)' == ''">true</UseNuGetPackage>
    <DaapiPackageVersion Condition="'$(DaapiPackageVersion)' == ''">0.5.0</DaapiPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuGetPackage)' != 'true'">
    <ProjectReference Include="$(DaapiSdkProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetPackage)' == 'true'">
    <PackageReference Include="DesktopAccountingAPI.QuickBooksDesktop" Version="$(DaapiPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)common/*.cs" Link="common/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckDaapiSdkCheckout" BeforeTargets="ResolveProjectReferences;CollectPackageReferences" Condition="'$(UseNuGetPackage)' != 'true' and !Exists('$(DaapiSdkProject)')">
    <Error Text="The .NET SDK is not checked out at $(DaapiSdkProject). Clone quickbooks-desktop-dotnet into $(SdkReposDir), set SDK_REPOS_DIR, or build without -p:UseNuGetPackage=false to use the NuGet package." />
  </Target>
</Project>
